{
  "patterns": [
    { "name": "private key", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----" },
    { "name": "AWS access key id", "regex": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "name": "GitHub token", "regex": "\\b(gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,})\\b" },
    { "name": "Anthropic API key", "regex": "\\bsk-ant-[A-Za-z0-9_-]{20,}" },
    { "name": "OpenAI API key", "regex": "\\bsk-(proj-|svcacct-)?[A-Za-z0-9_-]{32,}" },
    { "name": "Stripe live key", "regex": "\\b[sr]k_live_[0-9A-Za-z]{20,}\\b" },
    { "name": "Slack token", "regex": "\\bxox[abposr]-[A-Za-z0-9-]{10,}" },
    { "name": "Google API key", "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
    { "name": "JSON web token", "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}" },
    { "name": "password in a URL", "regex": "\\b[a-z][a-z0-9+.-]*://[^\\s:/@]+:[^\\s:/@]{3,}@" },
    { "name": "assigned secret", "regex": "\\b(password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret)\\b\\s*[:=]\\s*[\"']?[^\\s\"']{8,}", "flags": "i" }
  ]
}
